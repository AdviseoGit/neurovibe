+@app.route('/api/stats/leads')
+def stats_leads():
+    try:
+        with sqlite3.connect(DB_PATH) as conn:
+            c = conn.cursor()
+            c.execute("SELECT COUNT(*) FROM leads")
+            total = c.fetchone()[0]
+            c.execute("SELECT COUNT(*) FROM leads WHERE timestamp > datetime('now', '-7 days')")
+            last_7_days = c.fetchone()[0]
+            return jsonify({'total': total, 'last_7_days': last_7_days})
+    except Exception as e:
+        return jsonify({'error': str(e)}), 500
+
 if __name__ == '__main__':
